# ---------------------------------------------------------------------------
# RestorApp - configuración del backend
# ---------------------------------------------------------------------------
# POSTGRES_HOST
# For MAC 0.0.0.0
# For WIN localhost
# For Docker "database"
POSTGRES_HOST=0.0.0.0
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=postgres
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_POOL_SIZE=10
PORT=3000
# Déjalo en 0.0.0.0 para desarrollo en red local.
# En producción detrás del proxy, 127.0.0.1 para no exponer el backend.
HOST=0.0.0.0

# Orígenes permitidos para CORS/Socket.io (separados por coma).
# Además de esta lista, el backend acepta automáticamente localhost y
# cualquier IP privada (192.168.x.x, 10.x.x.x, 172.16-31.x.x) en cualquier
# puerto. Así no hay que editar esto cuando cambie la IP del servidor.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# true cuando está detrás de Nginx/Caddy (usa X-Forwarded-For real).
TRUST_PROXY=false

PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n<your-rsa-private-key-here>\n-----END RSA PRIVATE KEY-----\n"
PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<your-rsa-public-key-here>\n-----END PUBLIC KEY-----\n"

# development | production
NODE_ENV="development"
