# ---------------------------------------------------------------------------
# RestorApp - configuración del frontend
# ---------------------------------------------------------------------------
# Hay dos formas de usarlo. Elige UNA según cómo vayas a servir la app.
#
# A) DESARROLLO (sin proxy, `npm run dev` en :3001)
#    El navegador habla con el backend en el mismo equipo por el puerto 3000.
#    El host se toma de la página, así que funciona con localhost o con la IP
#    de la máquina sin editar nada.
#
#      API_URL=http://127.0.0.1:3000
#      NEXT_PUBLIC_API_URL=http://localhost:3000
#      NEXT_PUBLIC_SOCKET_SAME_ORIGIN=false
#      COOKIE_SECURE=false
#
# B) PRODUCCIÓN EN RED LOCAL (con Nginx o Caddy, ver deploy/Caddyfile.example)
#    El navegador usa un solo origen y el proxy reparte /api/backend y
#    /socket.io. No hay IP en la configuración: al mover el sistema a otra
#    máquina solo se abre http://IP-DEL-SERVIDOR.
#
#      API_URL=http://127.0.0.1:3000
#      NEXT_PUBLIC_API_URL=
#      NEXT_PUBLIC_SOCKET_SAME_ORIGIN=true
#      COOKIE_SECURE=false        # true si el proxy sirve HTTPS
# ---------------------------------------------------------------------------

# URL que usa el servidor de Next.js para hablar con NestJS.
# En producción detrás del proxy debe apuntar siempre a 127.0.0.1.
API_URL=http://127.0.0.1:3000

# URL del backend para el navegador (Socket.io).
# Vacío = mismo origen (recomendado con proxy).
# Si se indica una URL, solo se usan su protocolo y su puerto; el host se toma
# de la página actual para que la cookie de sesión viaje correctamente.
NEXT_PUBLIC_API_URL=http://localhost:3000

# true = usar el mismo origen para Socket.io (detrás de Nginx/Caddy).
NEXT_PUBLIC_SOCKET_SAME_ORIGIN=false

# Cookie segura solo con HTTPS. En red local por HTTP debe quedar en false.
COOKIE_SECURE=false
